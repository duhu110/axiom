  uid=3_107 StaticText "e:{"captured_at": "2026-02-19T13:05:20.948369+00:00", "event": "on_retriever_start", "name": "VectorStoreRetriever", "run_id": "019c7601-4634-7d81-bdac-c5a26ae64900", "parent_ids": ["019c7601-42e6-7f52-bf76-f85c5aa2e7bc", "019c7601-4631-7de2-97ac-dcdc5597e61b"], "tags": ["seq:step:1", "PGVector", "FastEmbedEmbeddings"], "metadata": {"user_id": "f8133b8e-c488-45ee-82d3-466deb34768e", "kb_id": null, "thread_id": "eb6cbe67-792b-409c-9313-6940f3d981d9", "langgraph_step": 2, "langgraph_node": "search", "langgraph_triggers": ["branch:to:search"], "langgraph_path": ["__pregel_pull", "search"], "langgraph_checkpoint_ns": "search:e4cbfe37-4ca1-6476-0652-c28291fd4ca6", "checkpoint_ns": "search:e4cbfe37-4ca1-6476-0652-c28291fd4ca6", "ls_retriever_name": "vectorstore", "ls_vector_store_provider": "PGVector", "ls_embedding_provider": "FastEmbedEmbeddings"}, "data": {"input": {"query": "文档搜索功能使用方法"}}, "keys": ["data", "event", "metadata", "name", "parent_ids", "run_id", "tags"], "raw": {"event": "on_retriever_start", "data": {"input": {"query": "文档搜索功能使用方法"}}, "name": "VectorStoreRetriever", "tags": ["seq:step:1", "PGVector", "FastEmbedEmbeddings"], "run_id": "019c7601-4634-7d81-bdac-c5a26ae64900", "metadata": {"user_id": "f8133b8e-c488-45ee-82d3-466deb34768e", "kb_id": null, "thread_id": "eb6cbe67-792b-409c-9313-6940f3d981d9", "langgraph_step": 2, "langgraph_node": "search", "langgraph_triggers": ["branch:to:search"], "langgraph_path": ["__pregel_pull", "search"], "langgraph_checkpoint_ns": "search:e4cbfe37-4ca1-6476-0652-c28291fd4ca6", "checkpoint_ns": "search:e4cbfe37-4ca1-6476-0652-c28291fd4ca6", "ls_retriever_name": "vectorstore", "ls_vector_store_provider": "PGVector", "ls_embedding_provider": "FastEmbedEmbeddings"}, "parent_ids": ["019c7601-42e6-7f52-bf76-f85c5aa2e7bc", "019c7601-4631-7de2-97ac-dcdc5597e61b"]}}"
